# GymGo Environment Variables
PORT=3000
NODE_ENV=production
JWT_SECRET=gymgo_secret_jwt_key_2026_super_secure

# Database - Optional for Render Persistence
# Leave blank for local JSON/in-memory file storage.
# Paste your free MongoDB Atlas URI here for permanent cloud persistence across Render spins:
MONGODB_URI=mongodb+srv://username:password@cluster0.abcde.mongodb.net/gymgo?retryWrites=true&w=majority

# Payment Gateway (Razorpay / UPI)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_rzp_secret_key

# AI Coach / LLM API Key (Google Gemini)
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# Maps & Locations (Google Maps Platform)
GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_GOOGLE_MAPS_KEY_HERE
